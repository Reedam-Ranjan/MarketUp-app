# Marketcap environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.

# ---- Market data: Finnhub ----------------------------------------------------
# Free API key from https://finnhub.io/dashboard
# Server-side only (NO NEXT_PUBLIC_ prefix) so the key is never exposed
# to the browser — quotes/search/news are proxied through Next.js API routes.
FINNHUB_API_KEY=

# ---- Chart history: Twelve Data ----------------------------------------------
# Free key from https://twelvedata.com/pricing (free = 800 req/day).
# Server-side only. Powers the price-history charts. Without it, the "demo"
# key is used, which only returns data for AAPL.
TWELVE_DATA_API_KEY=

# ---- Supabase ----------------------------------------------------------------
# From Supabase dashboard > Project Settings > API.
# URL + publishable (anon) key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only. Bypasses RLS to update subscription status from Stripe
# webhooks (service_role key). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (TEST / sandbox mode) --------------------------------------------
# TEST keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring price ID for the $20/mo Pro plan.
STRIPE_PRICE_ID=
# Webhook signing secret (from `stripe listen` locally, or the dashboard).
STRIPE_WEBHOOK_SECRET=

# Base URL used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
