# Marketcap environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.

# ---- Market data: Finnhub ----------------------------------------------------
# Free API key from https://finnhub.io/dashboard
# Server-side only (NO NEXT_PUBLIC_ prefix) so the key is never exposed
# to the browser — quotes/search/news are proxied through Next.js API routes.
FINNHUB_API_KEY=

# ---- Supabase (added in a later phase) ---------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
